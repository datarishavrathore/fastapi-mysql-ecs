{
    "containerDefinitions": [
        {
            "name": "api-container",
            "image": "PLACEHOLDER",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp",
                    "name": "main-8000-tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                { "name": "MYSQL_DATABASE", "value": "fast_api_db" },
                { "name": "MYSQL_PASSWORD", "value": "PLACEHOLDER" },
                { "name": "MYSQL_PORT", "value": "3306" },
                { "name": "MYSQL_HOST", "value": "fastapi-db.cshksu4qy21j.us-east-1.rds.amazonaws.com" },
                { "name": "MYSQL_USER", "value": "admin" }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/elastic-server-w0hffo",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "elastic-server-w0hffo",
    "executionRoleArn": "arn:aws:iam::452857281784:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "enableFaultInjection": false,
    "tags": []
}